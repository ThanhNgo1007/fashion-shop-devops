# ─────────────────────────────────────────────
# D.E Fashion Backend — Docker Environment
# Copy this file to .env.backend and fill in your values
# ─────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# MongoDB — for local Docker, use the container service name
# For local dev with docker-compose: mongodb://mongo:27017/fashionshop
# For MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_USER=your_mongo_user
MONGO_PASSWORD=your_mongo_password
MONGO_CLUSTER=your_cluster.mongodb.net

# JWT
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Frontend URL (for CORS)
FE_URL_LOCAL=http://localhost:3000
FE_URL_PROD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# VNPay Sandbox (optional)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=
VNP_RETURN_URL=

# Gemini API (optional)
GEMINI_API_KEY=
